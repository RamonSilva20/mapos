APP_NAME="Map-OS"
APP_SUBNAME="Sistema de Controle de Ordens de Serviço"
APP_TIMEZONE=America/Sao_Paulo
APP_BASEURL="enter_baseurl"
APP_CHARSET=UTF-8
APP_ENCRYPTION_KEY="enter_encryption_key"
APP_ENVIRONMENT="pre_installation"

APP_SESS_DRIVER=database
APP_SESS_COOKIE_NAME=MAPOS_SESSION
APP_SESS_EXPIRATION=7200
APP_SESS_SAVE_PATH=ci_sessions
APP_SESS_MATCH_IP=false
APP_SESS_TIME_TO_UPDATE=300
APP_SESS_REGENERATE_DESTROY=true

APP_COOKIE_PREFIX=
APP_COOKIE_DOMAIN=
APP_COOKIE_PATH=/
# auto: Secure só quando o acesso é por HTTPS. Atrás de proxy reverso, o
# X-Forwarded-Proto só é aceito vindo de um IP listado em APP_PROXY_IPS.
# Detalhes em docs/cookies-e-sessao.md.
APP_COOKIE_SECURE=auto
APP_COOKIE_HTTPONLY=true
APP_COOKIE_SAMESITE=Lax

APP_CSRF_PROTECTION=true
APP_CSRF_TOKEN_NAME="MAPOS_CSRF_TOKEN"
APP_CSRF_COOKIE_NAME="MAPOS_CSRF_COOKIE"
APP_CSRF_EXPIRE=7200
APP_CSRF_REGENERATE=true

APP_COMPRESS_OUTPUT=false
APP_PROXY_IPS=

# Cabeçalhos de segurança. Detalhes em docs/cabecalhos-de-seguranca.md.
# HSTS só é enviado em acesso por HTTPS; 0 desliga.
APP_SECURITY_HEADERS=true
APP_HSTS_MAX_AGE=31536000
APP_HSTS_INCLUDE_SUBDOMAINS=false
# Politica de seguranca de conteudo. enforce bloqueia o que ela nao permite, report-only so registra
# as violacoes e off desliga. Os relatorios vao para application/logs/csp-violacoes.json.
APP_CSP=enforce
# Envia os relatorios de violacao ao endpoint do Map-OS.
APP_CSP_REPORT=true

DB_DSN=
DB_HOSTNAME="enter_db_hostname"
DB_USERNAME="enter_db_username"
DB_PASSWORD="enter_db_password"
DB_DATABASE="enter_db_name"
DB_DRIVER=mysqli
DB_PREFIX=
DB_CHARSET=utf8
DB_COLLATION=utf8_general_ci

EMAIL_PROTOCOL=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_CRYPTO=tls
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=seuemail@gmail.com
EMAIL_SMTP_PASS=senhadoemail
EMAIL_VALIDATE=true
EMAIL_MAILTYPE=html
EMAIL_CHARSET=utf-8
EMAIL_NEWLINE="\r\n"
EMAIL_BCC_BATCH_MODE=false
EMAIL_WORDWRAP=false
EMAIL_PRIORITY=3

PAYMENT_GATEWAYS_EFI_PRODUCTION=false
PAYMENT_GATEWAYS_EFI_CREDENTIAIS_CLIENT_ID=
PAYMENT_GATEWAYS_EFI_CREDENTIAIS_CLIENT_SECRET=
PAYMENT_GATEWAYS_EFI_TIMEOUT=30
PAYMENT_GATEWAYS_EFI_BOLETO_EXPIRATION=P3D

PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_ACCESS_TOKEN=
PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_PUBLIC_KEY=
PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_CLIENT_ID=
PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_CLIENT_SECRET=
PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_INTEGRATOR_ID=
PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_PLATFORM_ID=
PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_CORPORATION_ID=
PAYMENT_GATEWAYS_MERCADO_PAGO_BOLETO_EXPIRATION=P3D

PAYMENT_GATEWAYS_ASAAS_PRODUCTION=false
PAYMENT_GATEWAYS_ASAAS_NOTIFY=false
PAYMENT_GATEWAYS_ASAAS_CREDENTIAIS_API_KEY=
PAYMENT_GATEWAYS_ASAAS_BOLETO_EXPIRATION=P3D

API_ENABLED=enter_api_enabled
API_JWT_KEY="enter_jwt_key"
API_TOKEN_EXPIRE_TIME=enter_token_expire_time
# Duração do refresh token da API, em segundos. Padrão: 30 dias.
API_REFRESH_TOKEN_EXPIRE_TIME=2592000
# CORS da API, só para o app web. Origens separadas por vírgula, ou *. Vazio: sem CORS.
API_CORS_ORIGINS=
# Requisições por minuto por IP. 0 desliga o limite.
API_RATE_LIMIT=300

# Inclui pré-releases na busca de atualização do Map-OS. Padrão: só releases estáveis.
UPDATER_PRERELEASES=false

IMPRIMIR_ANEXOS=false

# Pasta dos anexos de OS e dos arquivos enviados absoluta ou relativa à raiz do projeto.
# Aponte para FORA da pasta pública do servidor web. Vazio: application/storage, protegida
# por .htaccess; no nginx, bloqueie a pasta. Detalhes em docs/armazenamento-de-arquivos.md.
STORAGE_PATH=
# Tamanho máximo de cada upload, em KB. Vazio: 10240, ou seja 10 MB. Também vale o limite do PHP
# upload_max_filesize e post_max_size.
UPLOAD_MAX_KB=
# Limite de pixels de uma imagem enviada, largura vezes altura. Vazio: 40000000, ou seja 40 megapixels.
# Protege a memória do servidor ao gerar miniaturas e PDFs.
UPLOAD_MAX_PIXELS=

WHOOPS_ERROR_PAGE_ENABLED=false
