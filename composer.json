{
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-gd": "*",
        "mercadopago/dx-php": "^3.8.0",
        "efipay/sdk-php-apis-efi": "^1.17.0",
        "codeigniter/framework": "^3.1.13",
        "mpdf/mpdf": "^8.2.7",
        "mk-j/php_xlsxwriter": "^0.38.0",
        "mpdf/qrcode": "^1.2.2",
        "phpoffice/phpword": "^0.18.3",
        "piggly/php-pix": "^2.0.2",
        "vlucas/phpdotenv": "^5.6.3",
        "codephix/asaas-sdk": "^2.0.12",
        "filp/whoops": "^2.18.4",
        "ezyang/htmlpurifier": "^4.19"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93.0",
        "symfony/var-dumper": "^6.4.32",
        "fakerphp/faker": "^1.24.1",
        "phpunit/phpunit": "^12.5",
        "brianium/paratest": "7.20.0"
    },
    "scripts": {
        "format": [
            "application/vendor/bin/php-cs-fixer fix"
        ],
        "format:check": [
            "application/vendor/bin/php-cs-fixer fix --dry-run --diff"
        ],
        "xss:check": [
            "@php tools/check_view_escaping.php"
        ],
        "xss:baseline": [
            "@php tools/check_view_escaping.php --update-baseline"
        ],
        "test": [
            "@php application/tests/bin/setup-db.php",
            "@php application/vendor/bin/phpunit"
        ],
        "test:parallel": [
            "@php application/tests/bin/setup-db.php",
            "@php application/vendor/bin/paratest --processes=4"
        ],
        "test:db": [
            "@php application/tests/bin/setup-db.php"
        ],
        "test:fresh": [
            "@php application/tests/bin/setup-db.php --fresh"
        ],
        "test:clean": [
            "@php application/tests/bin/drop-worker-databases.php"
        ],
        "check:parity": [
            "@php application/tests/bin/check-schema-parity.php"
        ]
    },
    "config": {
        "vendor-dir": "application/vendor"
    },
    "autoload": {
        "psr-4": {
            "Libraries\\": "application/libraries",
            "Tools\\": "tools/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "application/tests/"
        }
    },
    "type": "project"
}
