<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

RewriteEngine On

# Pastas ocultas (.git, .github, .idea, .claude...) não são públicas: o bloco acima
# só pega arquivos. O .well-known (ACME, security.txt) continua liberado.
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

# Código-fonte, scripts de atualização e arquivos de projeto não são públicos
# (docs/servidor-web.md). application/ tem o próprio .htaccess.
RewriteRule ^(updates|scripts|tests|docker|docs)(/|$) - [F,L]
RewriteRule ^[^/]+\.(sql|json|lock|md|xml|neon|bat|sh|dist)$ - [F,L,NC]

RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
